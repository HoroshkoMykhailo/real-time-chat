{
  "extends": "../../tsconfig.json",
  "include": ["src/**/*.ts", "src/**/*.js", "src/**/*.tsx", "vite.config.ts"],
  "exclude": ["node_modules", "build"],
  "files": ["packages.d.ts"],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "jsx": "react-jsx",
    "baseUrl": ".",
    "outDir": "build",
    "paths": {
      "~/*": ["./src/*"]
    }
  }
}
