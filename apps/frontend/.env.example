#
# APPLICATION
#
# API + Socket.IO base URL. For local dev, point at the backend. For production on the
# same host as the SPA (e.g. Cloud Run single service), you can omit this — the app uses
# window.location.origin at runtime.
# VITE_APP_PROXY_SERVER_URL=http://localhost:3001
VITE_APP_NODE_ENV=development
VITE_API_PATH=/api/v1
VITE_APP_PORT=3000
VITE_APP_HOST=localhost
