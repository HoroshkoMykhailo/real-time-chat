#
# APPLICATION
#
# APP_PORT - default. own preference might be used
APP_HOST=localhost
APP_PORT=3001
NODE_ENV=development

#
# MongoDB DATABASE Config
#
# MONGO_URI - default. has to be changed to local DB uri if it is different
# MONGO_TEST_URI - default. has to be changed to local test DB uri if it is different
MONGO_URI=mongodb://localhost:27017/real_time_chat
MONGO_TEST_URI=mongodb://localhost:27017/real_time_chat_test

#
# JWT
#
JWT_SECRET=secret_key
JWT_EXPIRATION_TIME=24h
JWT_ALGORITHM="HS256"

#
# ENCRYPTION
#
ENCRYPTION_SALT_ROUNDS=10
ENCRYPTION_ALGORITHM=aes-128-ecb
# Number of chars in the secret must meet the requirements of the algorithm.
ENCRYPTION_SECRET=secret_key_12345

#
# GOOGLE CLOUD KEYS
#
GOOGLE_CLOUD_PROJECT_ID=project_id
GOOGLE_CLOUD_STORAGE_BUCKET=your-bucket-name
# Optional overrides for chat summaries (Vertex AI Gemini)
# GOOGLE_CLOUD_VERTEX_LOCATION=us-central1
# GOOGLE_CLOUD_SUMMARY_MODEL=gemini-2.5-flash

#
# GOOGLE OAUTH (Sign in with Google — server-side redirect flow)
# REDIRECT_URI must match an "Authorized redirect URI" in Google Cloud Console.
# FRONTEND_URL is the SPA origin used after login (no trailing slash).
#
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/v1/auth/google/callback
# GOOGLE_OAUTH_FRONTEND_URL=http://localhost:3000
