# Copy to deploy/cloud-run.env.yaml (gitignored) and fill in values.
# Pass JWT_SECRET and ENCRYPTION_SECRET via Secret Manager + gcloud --set-secrets
# (do not put real secrets in this file for production).

NODE_ENV: production
APP_HOST: '0.0.0.0'
APP_PORT: '8080'

MONGO_URI: 'mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/real_time_chat?retryWrites=true&w=majority'
MONGO_TEST_URI: ''

GOOGLE_CLOUD_PROJECT_ID: 'your-gcp-project-id'
GOOGLE_CLOUD_STORAGE_BUCKET: ''
GOOGLE_CLOUD_VERTEX_LOCATION: europe-west4
GOOGLE_CLOUD_SUMMARY_MODEL: gemini-2.5-flash

ENCRYPTION_ALGORITHM: aes-128-ecb
ENCRYPTION_SALT_ROUNDS: '10'

JWT_ALGORITHM: HS256
JWT_EXPIRATION_TIME: 24h

GOOGLE_OAUTH_CLIENT_ID: ''
GOOGLE_OAUTH_CLIENT_SECRET: ''
GOOGLE_OAUTH_REDIRECT_URI: ''
GOOGLE_OAUTH_FRONTEND_URL: ''
